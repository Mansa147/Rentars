    "baseline": {
        "measuredAt": "2026-10-17",
        "environment": "production",
        "device": "Moto G4 (4x CPU slowdown)",
        "connection": "Slow 4G (400ms RTT, 400kbps down, 400kbps up)",
        "tool": "Lighthouse v11",
        "note": "Baselines should be updated quarterly or after major dependency changes"
    },
    "enforcement": {
        "ci": {
            "enabled": true,
            "failOnExcess": false,
            "warnThreshold": "10%",
            "command": "npm run build && npx lighthouse-ci autorun"
        },
        "monitoring": {
            "enabled": true,
            "tool": "Lighthouse CI + Web Vitals RUM",
            "alertThreshold": "20% regression",
            "dashboardUrl": "https://lighthouse-ci.yourcompany.com"
        }
    },
    "exceptions": {
        "process": "Exceptions require approval from tech lead with documented justification",
        "template": {
            "route": "/route-path",
            "exceededMetric": "bundleSize.js",
            "requestedBudget": "500kb",
            "currentBudget": "400kb",
            "justification": "New feature X requires library Y (100kb gzipped)",
            "mitigations": "Lazy load library, code split by route",
            "approvedBy": "Tech Lead Name",
            "approvedDate": "YYYY-MM-DD",
            "reviewDate": "YYYY-MM-DD (3 months from approval)"
        },
        "approved": []
    },
    "optimization": {
        "lazyLoadComponents": [
            "Leaflet map (apps/web/src/components/properties/PropertyMap.tsx)",
            "Stellar SDK (apps/web/src/lib/stellar.ts)",
            "Freighter wallet adapter (apps/web/src/lib/freighter-utils.ts)",
            "Recharts (apps/web/src/components/dashboard/*)",
            "Image gallery lightbox"
        ],
        "imageOptimization": {
            "formats": [
                "webp",
                "avif"
            ],
            "sizes": {
                "thumbnail": "320w",
                "card": "640w",
                "detail": "1280w",
                "hero": "1920w"
            },
            "quality": 85,
            "devicePixelRatios": [
                1,
                2
            ]
        },
        "codeSplitting": {
            "strategy": "route-based + dynamic imports",
            "chunks": [
                "framework (React, Next.js)",
                "commons (shared utilities)",
                "route-specific (per page)"
            ]
        }
    },
    "monitoring": {
        "realUserMonitoring": {
            "enabled": true,
            "sampleRate": 0.1,
            "reportTo": "/api/v1/web-vitals"
        },
        "syntheticMonitoring": {
            "frequency": "hourly",
            "locations": [
                "us-east",
                "eu-west",
                "ap-southeast"
            ],
            "devices": [
                "mobile",
                "desktop"
            ]
        }
    }
}