{
  "name": "rentars-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend for Rentars — decentralized P2P rental platform on Stellar",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build ./src/index.ts --outdir ./dist",
    "start": "bun run dist/index.js",
    "test": "bun test --coverage",
    "test:unit": "bun test tests/unit --coverage",
    "test:integration": "bun test tests/integration --coverage",
    "test:e2e": "bun test tests/integration/booking-e2e.test.ts",
    "test:rls": "bun test tests/rls --coverage",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov --coverage-dir=./coverage",
    "test:api": "bash tests/api/simple.test.sh && bash tests/api/endpoints.test.sh && bash tests/api/profile.test.sh",
    "test:docker": "bash tests/docker/integration.test.sh",
    "test:contract": "bun test tests/contract.test.ts",
    "test:property-based": "bun test tests/unit/property-based.test.ts",
    "test:concurrency": "bun test tests/integration/concurrency.test.ts",
    "test:performance": "bun test tests/integration/booking-performance.test.ts",
    "test:journey": "bun test tests/integration/booking-journey.test.ts",
    "validate:migrations": "bun run scripts/validate-migrations.ts",
    "db:seed": "bun run database/seed.ts"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^15.1.0",
    "@supabase/supabase-js": "^2.39.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.10",
    "p-limit": "^7.3.0",
    "rate-limiter-flexible": "^5.0.5",
    "redis": "^6.0.0",
    "sharp": "^0.33.5",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.1",
    "@types/nodemailer": "^8.0.0",
    "@types/supertest": "^7.2.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "bun-types": "latest",
    "supertest": "^7.2.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
