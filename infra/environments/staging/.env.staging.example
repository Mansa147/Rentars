# Rentars Staging - Non-secret environment variables (example)
# Copy to .env.staging and fill in values from secrets provider

# API Configuration
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Supabase (non-secret URLs - secrets injected separately)
SUPABASE_URL=https://your-staging-project.supabase.co

# CORS
CORS_ORIGIN=https://staging.rentars.app

# Stellar/Soroban (testnet)
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
PROPERTY_LISTING_CONTRACT_ID=
BOOKING_CONTRACT_ID=

# Trustless Work
TRUSTLESS_WORK_API_URL=https://api.sandbox.trustlesswork.com

# Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@staging.rentars.app
EMAIL_FROM=Rentars Staging <no-reply@staging.rentars.app>

# hCaptcha
HCAPTCHA_ENABLED=true

# Data retention (staging - shorter windows)
RETENTION_INTERVAL_HOURS=24
RETENTION_BATCH_SIZE=500
RETENTION_RUN_ON_STARTUP=false
